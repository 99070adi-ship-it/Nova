VITE_API_BASE_URL=http://localhost:8100/api/v1
# Optional, single-store deployments only: pin the store this build serves. Leave unset so the store comes from ?org=.
# VITE_ORG_SLUG=your-store-slug
# Comma-separated origins of the admin app that may embed this storefront for Store Builder editing. Required in production.
VITE_ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
