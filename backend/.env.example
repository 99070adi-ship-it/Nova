# Local defaults below.
ENV=local
DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5440/nova
JWT_SECRET=dev-secret-change-me-please-32-bytes-minimum
AI_PROVIDER=fake
IMAGE_PROVIDER=fake
# Real AI: set AI_PROVIDER=nvidia and a key from https://build.nvidia.com (server-side only; never in the frontend).
# NVIDIA's free developer endpoints are for prototyping, research, development and testing; see README-ai.md before any production use.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_CHAT_TEMPLATE_KWARGS={"enable_thinking": false}   # non-reasoning replies; needed for nemotron-3.5-lightning
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1
OPENAI_API_KEY=
# Text-to-speech for the NOVA Guide: self-hosted Kokoro-82M (no API key, no per-request cost).
# Needs `pip install -e ".[voice]" -c constraints-voice.txt`; without it the Guide is simply text-only.
# See README-voice.md for resource requirements. TTS_PROVIDER=fake plays a short tone (playback checks).
TTS_PROVIDER=kokoro
KOKORO_LANG_CODE=a          # a = American English, b = British English
KOKORO_VOICE=af_heart       # e.g. af_bella, af_nicole, am_michael, bf_emma
KOKORO_SPEED=1.0
KOKORO_DEVICE=cpu           # cpu | cuda | mps | auto
# KOKORO_CACHE_DIR=/var/cache/nova-models   # where the model is cached (default ~/.cache/huggingface)
TTS_PRELOAD=false           # true = load the model at startup instead of on the first Guide visit

# --- Cloudflare Workers AI (free image generation) -------------------------------------------------
# Account ID: Cloudflare dashboard > Workers & Pages (right sidebar), or the 32-char id in the dashboard URL.
# API token: dash.cloudflare.com/profile/api-tokens > Create Token > "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# --- Photo Studio ------------------------------------------------------------------------------------
# cloudflare = real FLUX generation + editing (needs the two Cloudflare values above). "fake" is accepted ONLY when ENV=local.
STUDIO_PROVIDER=cloudflare
STUDIO_DAILY_LIMIT=20          # generations + edits per user per UTC day
STUDIO_BURST_PER_MINUTE=6

# --- Production only (ENV != local) --------------------------------------------------------------------
# The server refuses to start in production with the dev JWT_SECRET. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB   (also accepts a postgresql:// URL)
# CORS_ORIGINS=["https://your-admin.vercel.app","https://your-storefront.vercel.app"]
# COOKIE_SAMESITE=none   # only if the admin and the API are on different sites; HTTPS required
